<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Существующие элементы -->
        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="104dp"
            android:ems="10"
            android:inputType="text"
            android:text="Name"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="175dp"
            android:layout_height="50dp"
            android:layout_marginTop="40dp"
            android:text="Save"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/checkBtn"
            android:layout_width="175dp"
            android:layout_height="50dp"
            android:layout_marginTop="108dp"
            android:layout_marginBottom="8dp"
            android:text="Check name"
            android:layout_gravity="center_horizontal" />

        <Button
            android:id="@+id/delBtn"
            android:layout_width="175dp"
            android:layout_height="50dp"
            android:layout_marginTop="176dp"
            android:text="Delete"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp"/>

        <!-- Новые элементы для базы данных -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Работа с базой данных"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/dbName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Имя пользователя для БД"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Телефон"
            android:inputType="phone"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Возраст"
            android:inputType="number"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Адрес"
            android:inputType="textPostalAddress"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/saveToDbBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Сохранить в БД"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/searchBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Поиск"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Новое поле для поиска -->
        <EditText
            android:id="@+id/searchName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите имя для поиска"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/updateBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Обновить"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/deleteBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Удалить"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Поле для ввода ID -->
        <EditText
            android:id="@+id/idInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите ID для удаления"
            android:inputType="number"
            android:layout_marginBottom="8dp"/>

        <!-- TextView для отображения информации о пользователе -->
        <TextView
            android:id="@+id/userInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="8dp"
            android:textSize="14sp"
            android:minHeight="100dp"
            android:scrollbars="vertical"
            android:text="Информация о пользователе будет отображаться здесь"/>

    </LinearLayout>
</ScrollView>